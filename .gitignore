# Ignore all markdown files everywhere
*.md

# Do not ignore project documentation that describes the current
# contract/design/audit state - keeping these tracked lets `git diff`
# catch drift between docs and code instead of it going unnoticed (see
# Reports/AUDIT-v2.md §0/§7.4: this is how a whole round of fixes
# documented in Reports/AUDIT.md never actually landed in source, with
# nothing to catch it).
!/README.md
!/CLAUDE.md
!/DESIGN.md
!/DESIGN-dash_pro.md
!/QUICKSTART.md
!/DOCUMENTATION.md
!/Reports/*.md

# Compiled Python bytecode / JIT caches - never source of truth, and a
# stale committed copy previously masked lost source changes (see
# Reports/AUDIT-v2.md §0's Numba .nbc/.nbi forensic evidence).
__pycache__/
*.pyc
*.nbc
*.nbi

# Trained model checkpoint - regenerated by synthetic_train_loop_v5.py,
# shouldn't be a binary diff in every retrain commit.
snn_weights.pth

reference_images/
